# Copia este archivo a .env si quieres cambiar el comportamiento por defecto.
# No pongas claves de pago: Helios no las usa.

OLLAMA_HOST=http://127.0.0.1:11434
HELIOS_TEXT_MODEL=qwen2.5:7b
HELIOS_TEXT_FALLBACKS=qwen2.5:3b,llama3.2:3b
HELIOS_VISION_MODEL=qwen2.5vl:7b
HELIOS_VISION_FALLBACKS=llava:7b,moondream
HELIOS_WHISPER_MODEL=small
HELIOS_WHISPER_DEVICE=cpu
HELIOS_WHISPER_COMPUTE=int8
# edge usa la voz neuronal gratuita de Microsoft, sin clave.
# system fuerza la voz offline del sistema. off deja solo el guion escrito.
HELIOS_TTS=edge
HELIOS_TTS_VOICE=es-ES-ElviraNeural
HELIOS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HELIOS_CLIP_MODEL=ViT-B-32
HELIOS_CLIP_PRETRAINED=openai
HELIOS_CACHE=1
HELIOS_EUR_KWH=0.18
HELIOS_WATTS=65
